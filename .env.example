# Copy to .env (gitignored) before running Compose: cp .env.example .env
# Local development values only. Change the password if you expose the port beyond your machine.

POSTGRES_USER=labpipe
POSTGRES_PASSWORD=labpipe
POSTGRES_DB=labpipe

# Port Postgres is published on, on your machine. Change it if 5432 is taken.
POSTGRES_PORT=5432

# Optional: load a full Athena download (mounted at /app/data/vocab) instead of the
# committed subset in db/vocab_subset/.
# LABPIPE_VOCAB_DIR=/app/data/vocab

# BridgeLink interface engine. Its admin API is at https://localhost:8443/api/ (admin / admin,
# the image's default; local only). The pipeline sends HL7 over MLLP to port 6661.
# Change either published port if it is taken on your machine.
BRIDGELINK_ADMIN_PORT=8443
BRIDGELINK_MLLP_PORT=6661
