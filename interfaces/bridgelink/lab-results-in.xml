        <username></username>
        <password></password>
        <query>// Write the accepted ORU^R01 to staging.raw_message, exactly as received.
// Credentials come from the container&apos;s environment (the same .env as the db service),
// so no password is stored in this channel file.
var env = java.lang.System.getenv();
var url = &apos;jdbc:postgresql://&apos; + env.get(&apos;POSTGRES_HOST&apos;) + &apos;:5432/&apos; + env.get(&apos;POSTGRES_DB&apos;);
// String(...) turns the Java string into a JavaScript one, so split() below takes plain
// text. Java&apos;s own split() takes a regular expression, where &apos;|&apos; means &quot;nothing or nothing&quot;
// and would split between every character.
var raw = String(connectorMessage.getRawData());

// MSH-10 is the 10th field of the first segment. MSH-1 is the field separator itself,
// so after splitting on &apos;|&apos; it sits at index 9.
var msh10 = raw.split(&apos;\r&apos;)[0].split(&apos;|&apos;)[9];
if (!msh10) {
    // Throwing marks this destination as errored, so the engine answers AE instead of AA.
    throw &apos;MSH-10 (message control ID) is empty&apos;;
}

var dbConn = DatabaseConnectionFactory.createDatabaseConnection(
    &apos;org.postgresql.Driver&apos;, url, env.get(&apos;POSTGRES_USER&apos;), env.get(&apos;POSTGRES_PASSWORD&apos;));
try {
    var params = new java.util.ArrayList();
    params.add(msh10);
    params.add(raw);
    // A resend of a message already staged is skipped, never duplicated or overwritten.
    var inserted = dbConn.executeUpdate(
        &quot;INSERT INTO staging.raw_message (msh10, message_type, raw) VALUES (?, &apos;ORU^R01&apos;, ?) &quot; +
        &quot;ON CONFLICT (msh10) DO NOTHING&quot;, params);
    channelMap.put(&apos;staged&apos;, inserted == 1 ? &apos;new&apos; : &apos;duplicate&apos;);
} finally {
    dbConn.close();
}
</query>
